{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sfn-slc",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_URL": "https://slc.skyfirst.io.vn",
    "SUPPORT_EMAIL": "support@skyfirst.io.vn",
    "APP_NAME": "Trung tâm Học tập Số Sky First Network",
    "SESSION_DAYS": "30",
    "MAIL_FROM": "SLC · Sky First Network <support@skyfirst.io.vn>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sfn-slc-db",
      "database_id": "6fd6a6c3-aae6-4b11-89e0-8e13a0e27d3c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "skyfirsthoctap"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "LIVE_ROOM", "class_name": "LiveRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LiveRoom"] }
  ]
}
